{
  "name": "daily-forge-app",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@types/mocha": "^10.0.10",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-fast-confetti": "^2.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^13.0.3",
    "eas-cli": "24.7.0",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "update:expo": "eas update --branch preview --environment preview && npx sentry-expo-upload-sourcemaps dist",
    "upgrade": "bun install expo@latest && npx expo install --fix",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "release:android": "npx expo run:android --variant Release",
    "release:ios": "npx expo run:ios --configuration Release",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "eslint . --ext .js,.jsx,.ts,.tsx --fix && prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "@shopify/react-native-skia"
  ]
}
