{
  "name": "daily-forge-app",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.11.2",
    "expo": "^58.0.0-preview.4",
    "expo-asset": "~58.0.4",
    "expo-audio": "~58.0.1",
    "expo-constants": "~58.0.4",
    "expo-crypto": "~58.0.2",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-linking": "~58.0.4",
    "expo-notifications": "~58.0.4",
    "expo-router": "~58.0.5",
    "expo-sharing": "~58.0.7",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.4",
    "expo-updates": "~58.0.6",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-fast-confetti": "^2.0.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.3",
    "test-renderer": "^1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "update:expo": "eas update --branch preview --environment preview && npx sentry-expo-upload-sourcemaps dist",
    "upgrade": "bun install expo@latest && npx expo install --fix",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "release:android": "npx expo run:android --variant Release",
    "release:ios": "npx expo run:ios --configuration Release",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "eslint . --ext .js,.jsx,.ts,.tsx --fix && prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "@shopify/react-native-skia"
  ]
}
